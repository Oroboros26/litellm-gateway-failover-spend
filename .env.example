# Provider keys: leave empty here, set your own in .env (never commit .env)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local development values: change them before any real use
LITELLM_MASTER_KEY=sk-change-me
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://litellm:<POSTGRES_PASSWORD>@postgres:5432/litellm
REDIS_HOST=redis

# Endpoints used by the scripts in eval/
LITELLM_URL=http://localhost:4000
GATEWAY_URL=http://localhost:8080
# EVAL_KEY=<a virtual key printed by `make keys`>
